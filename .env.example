# === WordPress 인증 (Day 1: 비워둠 → 자동 mock 모드) ===
# 도구 우선 빌드: 실 WP 사이트 세팅 후 아래 3개 채우기
WP_SITE_URL=
WP_USER=
WP_APP_PASSWORD=

# === 모드 (Day 1 기본값) ===
# true: MockWordPressClient / false: RealWordPressClient
# WP_SITE_URL 비어있으면 자동으로 mock
WP_MOCK=true

# === AI (W2에서 사용) ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# OPENAI_API_KEY=sk-xxxx (옵션)

# === Google Search Console (W5 이후) ===
GSC_CREDENTIALS_PATH=./secrets/gsc-credentials.json

# === 경로 ===
DB_PATH=./data/wp_auto.db
LOG_DIR=./logs
